# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_db

OFFICE_START_TIME=10:00
GRACE_PERIOD_END=10:15
LATE_AFTER=10:16
OFFICE_END_TIME=19:00
TIMEZONE=Asia/Karachi

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=company-policy
PINECONE_NAMESPACE=company-policy

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HR_NOTIFY_EMAIL=

# JWT authentication — generate a secret with: openssl rand -hex 32
# Never commit .env. Leave JWT_SECRET_KEY empty and auth will fail fast.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional seed HR account (used only by backend/app/seed_auth.py).
# Set these in the local environment only, never in a committed file.
AWI_SEED_HR_EMAIL=
AWI_SEED_HR_PASSWORD=
AWI_SEED_HR_NAME=
