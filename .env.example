# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_db

OFFICE_START_TIME=10:00
GRACE_PERIOD_END=10:15
LATE_AFTER=10:16
OFFICE_END_TIME=19:00
TIMEZONE=Asia/Karachi

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=company-policy
PINECONE_NAMESPACE=company-policy

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HR_NOTIFY_EMAIL=
